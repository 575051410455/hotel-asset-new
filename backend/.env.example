# PostgreSQL connection string. Point this at your own database.
# Use a database name dedicated to this app (e.g. opsmonitor) — do NOT
# reuse another project's database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/opsmonitor

# Backend port (frontend dev server proxies /api here).
PORT=3000

# The public origin of the app: https in production (plain http only for localhost).
# Only requests from this origin may change data, and it makes the session cookies
# Secure. The backend refuses to start without a valid value.
FRONTEND_URL=http://localhost:5173

# ── Google "Sign in with Google" (optional) ──────────────────────────────────
# Leave CLIENT_ID/SECRET blank to disable — the login page hides the button.
# Create an OAuth 2.0 Client (type "Web application") in the Google Cloud console
# and add this Authorized redirect URI:  <FRONTEND_URL>/api/auth/google/callback
#   dev:  http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email domain allowed to auto-create accounts on first Google login. New users
# start with NO property access until an admin assigns a role. Existing users are
# matched by email regardless of domain. Blank = only pre-existing accounts.
GOOGLE_ALLOWED_DOMAIN=
# Optional: override the redirect URI if it isn't <FRONTEND_URL>/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
