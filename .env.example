# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose secrets for the Ops Monitor stack.
# Copy to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env
# Generate strong secrets:
#     POSTGRES_PASSWORD:  openssl rand -base64 24 | tr -d /+=
#     JWT_SECRET:         openssl rand -base64 48 | tr -d /+=
# ─────────────────────────────────────────────────────────────────────────────

# Public origin. This is NOT cosmetic: the backend derives the Google OAuth
# redirect_uri from it (lib/google-oauth.ts) and sets the `secure` flag on the
# OAuth state cookie from whether it starts with https://. No trailing slash.
#
#   Phase 1 — LAN only:  http://192.168.1.50      (this host's LAN address)
#   Phase 2 — published: https://map.csprint.co.th
FRONTEND_URL=http://localhost

# Postgres (the db service is created with these on first boot)
POSTGRES_DB=opsmonitor
POSTGRES_USER=opsmonitor
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing secret (HS256, 24h tokens). Keep this STABLE across deploys —
# changing it invalidates everyone's session.
JWT_SECRET=change-me-to-a-long-random-string

# ── Google "Sign in with Google" (optional) ──────────────────────────────────
# Leave blank to disable. Create an OAuth 2.0 "Web application" client in the
# Google Cloud console and register this Authorized redirect URI:
#     <FRONTEND_URL>/api/auth/google/callback
# e.g. https://ops.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email domain allowed to auto-create accounts on first Google sign-in (new users
# get NO property access until an admin assigns a role). Blank = existing users only.
GOOGLE_ALLOWED_DOMAIN=

# NOTE: the frontend needs NO build-time env — the SPA calls the API at a
# relative /api (same-origin via nginx), so there is no VITE_API_URL to set.

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# This stack does NOT run its own cloudflared. It reuses the tunnel already
# running on this host: that connector reaches our nginx over a shared Docker
# network, and the hostname is mapped in the Cloudflare Zero Trust dashboard
# (Public Hostname -> Service: http://<this project's nginx container>:80).
#
# There is therefore no tunnel token here, and the command never changes:
#     docker compose up -d --build
#
# See docs/html-deploy-production.html for the dashboard steps.
